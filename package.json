{
  "name": "mockmarket",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Synthetic markets. Fake money. Real lessons.",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:app && vite build && node scripts/prepare-pages.js",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:app && npm run typecheck:test && npm run typecheck:e2e",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "data:validate": "node scripts/data-integrity.js",
    "data:manifest": "node scripts/data-integrity.js --write-manifest",
    "data:export-tickers": "node scripts/export_tickers_json.js",
    "data:generate": "node scripts/generate_data.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.3",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "us-equity-market-calendar": "^1.0.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
